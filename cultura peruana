        // OBTENER PALABRA
        function getDailyWord() {
            const now = new Date();
            const start = new Date(now.getFullYear(), 0, 0);
            const diff = now - start;
            const dayOfYear = Math.floor(diff / (1000 * 60 * 60 * 24));
            return WORD_BANK[dayOfYear % WORD_BANK.length];
        }

        function getRandomWord() {
            return WORD_BANK[Math.floor(Math.random() * WORD_BANK.length)];
        }

        // INICIALIZAR MODO
        function initGame(mode) {
            state.mode = mode;
            state.attempts = [];
            state.currentInput = "";
            state.gameOver = false;
            resetKeyboardColors();

            if (mode === 1) {
                state.currentWordObj = getDailyWord();
                state.maxAttempts = 6;
                clueBoxEl.textContent = `📅 Adivina la Tradición del Día (${state.currentWordObj.word.length} letras)`;
            } else if (mode === 2) {
                state.currentWordObj = getRandomWord();
                state.maxAttempts = 4;
                clueBoxEl.textContent = `💡 Pista: "${state.currentWordObj.meaning}"`;
            } else if (mode === 3) {
                state.currentWordObj = getRandomWord();
                state.maxAttempts = 6;
                clueBoxEl.textContent = `🔍 [${state.currentWordObj.cat.toUpperCase()}] ${state.currentWordObj.meaning}`;
            }

            state.targetWord = state.currentWordObj.word.toUpperCase();

            if (mode === 2) {
                // Generar intento automático con huecos
                let fillMask = "";
                for (let i = 0; i < state.targetWord.length; i++) {
                    fillMask += (i % 2 === 0) ? state.targetWord[i] : "_";
                }
                state.currentInput = fillMask;
            }

            renderBoard();
        }

        // RENDERIZAR TABLERO
        function renderBoard() {
            boardEl.innerHTML = "";
            const wordLen = state.targetWord.length;

            if (state.mode === 1) {
                for (let r = 0; r < state.maxAttempts; r++) {
                    const rowEl = document.createElement('div');
                    rowEl.className = 'row';
                    const isCurrent = (r === state.attempts.length);
                    const attemptWord = state.attempts[r] || (isCurrent ? state.currentInput : "");

                    for (let c = 0; c < wordLen; c++) {
                        const tile = document.createElement('div');
                        tile.className = 'tile';
                        const letter = attemptWord[c] || "";
                        tile.textContent = letter;

                        if (letter && isCurrent && !state.gameOver) tile.classList.add('pop');

                        if (r < state.attempts.length) {
                            tile.classList.add('flip');
                            const res = getLetterStatus(attemptWord, c);
                            tile.classList.add(res);
                        }
                        rowEl.appendChild(tile);
                    }
                    boardEl.appendChild(rowEl);
                }
            } else if (state.mode === 2 || state.mode === 3) {
                // Fila única interactiva
                const rowEl = document.createElement('div');
                rowEl.className = 'row';

                for (let c = 0; c < wordLen; c++) {
                    const tile = document.createElement('div');
                    tile.className = 'tile';
                    const letter = state.currentInput[c] || "";
                    tile.textContent = (letter === "_") ? "" : letter;

                    if (state.gameOver && state.currentInput === state.targetWord) {
                        tile.classList.add('correct');
                    }
                    rowEl.appendChild(tile);
                }
                boardEl.appendChild(rowEl);
            }
        }

        // EVALUAR LETRAS PARA WORDLE
        function getLetterStatus(guess, index) {
            const letter = guess[index];
            const target = state.targetWord;

            if (target[index] === letter) return 'correct';

            let targetCount = 0, guessCount = 0;
            for (let i = 0; i < target.length; i++) {
                if (target[i] === letter) targetCount++;
                if (guess[i] === letter && target[i] === letter) targetCount--;
            }

            for (let i = 0; i <= index; i++) {
                if (guess[i] === letter && target[i] !== letter) guessCount++;
            }

            return (guessCount <= targetCount && targetCount > 0) ? 'present' : 'absent';
        }

        // TECLADO Y ENTRADAS
        function handleKeyPress(key) {
            if (state.gameOver) return;

            const wordLen = state.targetWord.length;

            if (key === 'BACKSPACE') {
                if (state.mode === 1) {
                    state.currentInput = state.currentInput.slice(0, -1);
                } else if (state.mode === 2 || state.mode === 3) {
                    // Borrar última letra ingresada
                    let arr = state.currentInput.split("");
                    for (let i = arr.length - 1; i >= 0; i--) {
                        if (arr[i] !== "_" && (state.mode === 3 || i % 2 !== 0)) {
                            arr[i] = "_";
                            break;
                        }
                    }
                    state.currentInput = arr.join("");
                }
                renderBoard();
                return;
            }

            if (key === 'ENTER') {
                if (state.mode === 1) {
                    if (state.currentInput.length < wordLen) {
                        shakeCurrentRow();
                        playSound('wrong');
                        return;
                    }
                    submitGuess(state.currentInput);
                } else if (state.mode === 2 || state.mode === 3) {
                    if (state.currentInput.includes("_")) {
                        shakeCurrentRow();
                        playSound('wrong');
                        return;
                    }
                    if (state.currentInput === state.targetWord) {
                        handleWin();
                    } else {
                        shakeCurrentRow();
                        playSound('wrong');
                    }
                }
                return;
            }

            if (/^[A-ZÑ]$/.test(key)) {
                if (state.mode === 1) {
                    if (state.currentInput.length < wordLen) {
                        state.currentInput += key;
                    }
                } else if (state.mode === 2) {
                    let arr = state.currentInput.split("");
                    for (let i = 0; i < arr.length; i++) {
                        if (arr[i] === "_" && i % 2 !== 0) {
                            arr[i] = key;
                            break;
                        }
                    }
                    state.currentInput = arr.join("");
                } else if (state.mode === 3) {
                    let arr = state.currentInput.split("");
                    for (let i = 0; i < arr.length; i++) {
                        if (arr[i] === "_") {
                            arr[i] = key;
                            break;
                        }
                    }
                    state.currentInput = arr.join("");
                }
                renderBoard();
            }
        }

        function submitGuess(guess) {
            state.attempts.push(guess);
            updateKeyboardColors(guess);

            if (guess === state.targetWord) {
                renderBoard();
                setTimeout(handleWin, 600);
            } else {
                if (state.attempts.length >= state.maxAttempts) {
                    renderBoard();
                    setTimeout(handleLoss, 600);
                } else {
                    playSound('wrong');
                    state.currentInput = "";
                    renderBoard();
                }
            }
        }

        function updateKeyboardColors(guess) {
            for (let i = 0; i < guess.length; i++) {
                const letter = guess[i];
                const status = getLetterStatus(guess, i);
                const keyEl = document.querySelector(`.key[data-key="${letter}"]`);
                if (keyEl) {
                    if (status === 'correct') {
                        keyEl.className = 'key correct';
                        playSound('correct');
                    } else if (status === 'present' && !keyEl.classList.contains('correct')) {
                        keyEl.className = 'key present';
                        playSound('present');
                    } else if (!keyEl.classList.contains('correct') && !keyEl.classList.contains('present')) {
                        keyEl.className = 'key absent';
                    }
                }
            }
        }

        function resetKeyboardColors() {
            document.querySelectorAll('.key').forEach(k => {
                k.className = k.classList.contains('wide') ? 'key wide' : 'key';
            });
        }

        function shakeCurrentRow() {
            const rows = boardEl.querySelectorAll('.row');
            const currentRow = rows[state.mode === 1 ? state.attempts.length : 0];
            if (currentRow) {
                currentRow.classList.add('shake');
                setTimeout(() => currentRow.classList.remove('shake'), 500);
            }
        }

        // MANEJO DE VICTORIA Y DERROTA
        function handleWin() {
            state.gameOver = true;
            playSound('win');

            // Cálculo de Puntos: 100 - (intentos-1)*10
            const attemptsCount = state.mode === 1 ? state.attempts.length : 1;
            const ptsGained = Math.max(10, 100 - (attemptsCount - 1) * 10);

            state.score += ptsGained;
            state.streak++;
            if (state.score > state.record) state.record = state.score;

            // Actualizar Estadísticas
            state.stats.totalWins++;
            if (state.currentWordObj.region.includes("Costa")) state.stats.costa++;
            if (state.currentWordObj.region.includes("Sierra")) state.stats.sierra++;
            if (state.currentWordObj.region.includes("Selva")) state.stats.selva++;

            checkAchievements(attemptsCount);
            saveStorage();
            updateStatsUI();

            showVictoryModal(ptsGained);
        }

        function handleLoss() {
            state.gameOver = true;
            playSound('wrong');
            state.streak = 0;
            saveStorage();
            updateStatsUI();

            showModal(`
                <h2>¡Casi lo logras! 🇵🇪</h2>
                <p>La palabra era: <strong>${state.targetWord}</strong></p>
                <div class="card-info">
                    <p><strong>Región:</strong> ${state.currentWordObj.region}</p>
                    <p><strong>Significado:</strong> ${state.currentWordObj.meaning}</p>
                </div>
                <button class="modal-btn" onclick="closeModal(); initGame(${state.mode});">Reintentar</button>
            `);
        }

        function checkAchievements(attempts) {
            let unlocked = state.stats.unlockedAchievements;
            if (state.stats.costa >= 3 && !unlocked.includes("costa")) unlocked.push("costa");
            if (state.stats.sierra >= 3 && !unlocked.includes("sierra")) unlocked.push("sierra");
            if (state.stats.selva >= 3 && !unlocked.includes("selva")) unlocked.push("selva");
            if (state.streak >= 5 && !unlocked.includes("streak5")) unlocked.push("streak5");
            if (attempts === 1 && !unlocked.includes("first_try")) unlocked.push("first_try");
            if (state.stats.totalWins >= 10 && !unlocked.includes("total10")) unlocked.push("total10");
        }

        // MODALES
        function showVictoryModal(pts) {
            showModal(`
                <h2>¡Excelente Acierto! 🎉</h2>
                <p>+${pts} Puntos ganados</p>
                <div class="card-info">
                    <p><strong>Palabra:</strong> ${state.targetWord}</p>
                    <p><strong>Categoría:</strong> ${state.currentWordObj.cat}</p>
                    <p><strong>Región:</strong> ${state.currentWordObj.region}</p>
                    <p><strong>Significado:</strong> ${state.currentWordObj.meaning}</p>
                    <br>
                    <p><strong>💡 Dato Curioso:</strong> ${state.currentWordObj.fact}</p>
                </div>
                <button class="modal-btn" onclick="closeModal(); initGame(${state.mode});">Siguiente Palabra</button>
            `);
        }

        function showModal(html) {
            modalContent.innerHTML = html;
            modalOverlay.classList.add('active');
        }

        function closeModal() {
            modalOverlay.classList.remove('active');
        }

        function showFactModal() {
            const randomObj = getRandomWord();
            showModal(`
                <h2>💡 Sabiduría Peruana</h2>
                <div class="card-info">
                    <p><strong>Tradición:</strong> ${randomObj.word}</p>
                    <p><strong>Región:</strong> ${randomObj.region}</p>
                    <p><strong>Dato Cultural:</strong> ${randomObj.fact}</p>
                </div>
                <button class="modal-btn" onclick="closeModal()">¡Entendido!</button>
            `);
        }

        function showStatsModal() {
            let achievementsHTML = ACHIEVEMENTS.map(a => {
                const isUnlocked = state.stats.unlockedAchievements.includes(a.id);
                return `
                    <div class="achievement-card ${isUnlocked ? 'unlocked' : ''}">
                        <div class="achievement-icon">${a.icon}</div>
                        <div>
                            <div class="achievement-title">${a.name} ${isUnlocked ? '✅' : ''}</div>
                            <div class="achievement-desc">${a.desc}</div>
                        </div>
                    </div>
                `;
            }).join('');

            showModal(`
                <h2>🏆 Logros y Estadísticas</h2>
                <p style="font-size:0.85rem; color:#666;">Victorias totales: <strong>${state.stats.totalWins}</strong></p>
                <div class="achievements-grid">
                    ${achievementsHTML}
                </div>
                <button class="modal-btn" onclick="closeModal()">Cerrar</button>
            `);
        }

        // LISTENERS DE EVENTOS
        document.querySelectorAll('.mode-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
                e.target.classList.add('active');
                const mode = parseInt(e.target.getAttribute('data-mode'));
                initGame(mode);
            });
        });

        keyboardEl.addEventListener('click', (e) => {
            if (e.target.classList.contains('key')) {
                const key = e.target.getAttribute('data-key');
                handleKeyPress(key);
            }
        });

        document.addEventListener('keydown', (e) => {
            if (modalOverlay.classList.contains('active')) return;
            const key = e.key.toUpperCase();
            if (key === 'ENTER') handleKeyPress('ENTER');
            else if (key === 'BACKSPACE') handleKeyPress('BACKSPACE');
            else if (/^[A-ZÑ]$/.test(key)) handleKeyPress(key);
        });

        document.getElementById('btnFact').addEventListener('click', showFactModal);
        document.getElementById('btnStats').addEventListener('click', showStatsModal);
        document.getElementById('btnSound').addEventListener('click', () => {
            state.sound = !state.sound;
            document.getElementById('btnSound').textContent = state.sound ? "🔊" : "🔇";
        });

        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) closeModal();
        });

        // INICIALIZACIÓN DE INICIO
        loadStorage();
        initGame(1);
    </script>
</body>
</html>
